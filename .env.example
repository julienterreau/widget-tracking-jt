PORT=3000
ADMIN_TOKEN=change-this-to-a-long-random-secret
# Set to 1 for a typical single reverse proxy (e.g. Render, Railway, Nginx).
# Set to 0 if the Node server is directly exposed to the internet.
PROXY_HOPS=1
# false = aucune visite enregistrée.
TRACKING_ENABLED=true
# Sites autorisés à utiliser le widget (origines complètes, séparées par des virgules).
# Pour rustyjamesblog.link :
ALLOWED_ORIGINS=https://rustyjamesblog.link,https://www.rustyjamesblog.link
# Cloudflare : true = le pays vient de l'en-tête CF-IPCountry et l'IP de CF-Connecting-IP.
# À n'activer que si ce serveur est derrière Cloudflare (proxy orange) et n'accepte que son trafic,
# sinon n'importe qui peut falsifier ces en-têtes. Pour la ville et la carte précises, activer dans
# Cloudflare : Règles > Transform Rules > Modifier les en-têtes de requête > « Ajouter les en-têtes de localisation des visiteurs ».
USE_CLOUDFLARE=false
# Même sel que VISITOR_SALT du site pour obtenir les mêmes identifiants visiteur (hash quotidien).
VISITOR_SALT=rj-visites
# false (défaut, comme le site) : l'adresse IP n'est jamais écrite sur disque.
STORE_IP=false
# Conservation : jours et nombre maximal de visites gardées.
RETENTION_DAYS=90
MAX_ROWS=20000
